[worldserver]

###################################################################################################
#    MOD TALENT MANAGER
#
#    Saved talent specs per character, with their glyphs and action bars. Pair it with the
#    TalentManager client addon (modules/mod-talent-manager/addon/TalentManager).
###################################################################################################

#
#    TalentManager.Enable
#        Description: Enable the talent manager.
#        Default:     1 (Enabled)
#                     0 (Disabled)
#

TalentManager.Enable = 1

#
#    TalentManager.MaxSpecs
#        Description: Maximum number of saved specs per character.
#        Default:     20
#

TalentManager.MaxSpecs = 20
